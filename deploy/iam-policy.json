{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockDashboardCloudWatchRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockDashboardCostExplorerRead",
      "Effect": "Allow",
      "Action": "ce:GetCostAndUsage",
      "Resource": "*"
    },
    {
      "Sid": "BedrockDashboardServiceQuotasRead",
      "Effect": "Allow",
      "Action": "servicequotas:GetServiceQuota",
      "Resource": "*"
    },
    {
      "Sid": "BedrockDashboardIdentityRead",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "cloudshell:ListEnvironments"
      ],
      "Resource": "*"
    }
  ]
}
